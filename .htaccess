Options -Indexes
DirectoryIndex index.php index.html

# Never expose Git metadata present inside Hostinger's public_html.
# FilesMatch alone does not protect nested .git/HEAD or .git/config paths.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:\.git|\.svn|\.hg)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^(\.htaccess|\.htpasswd|\.env(?:\..*)?|\.git|\.svn|\.hg|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
